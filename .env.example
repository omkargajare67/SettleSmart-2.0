# Application Environment
APP_ENV=development
APP_PORT=8000

# Security and CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=false
ENABLE_PUBLIC_REGISTRATION=true

# Database Configuration (MySQL 8.4+ / 9.x)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=settlesmart
DB_USER=settlesmart_user
DB_PASSWORD=replace_with_your_password
DB_SSL_MODE=preferred

# WebSocket Server Configuration (Step 7)
WEBSOCKET_PORT=8081

# Frontend Configuration (Step 10)
FRONTEND_PORT=3000
